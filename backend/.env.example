# Random Voice Social App backend environment example
# Copy this file to .env for host-local development on Windows.
# Do not commit .env. Use real random secrets in production.

NODE_ENV=development
PORT=3000

# Host-local backend development: NestJS runs on Windows host, PostgreSQL/Redis run in Docker.
DATABASE_URL=postgresql://app:app_password@localhost:15432/random_voice_social?schema=public
REDIS_URL=redis://localhost:56379

# Docker backend container values. docker-compose.yml overrides these for the optional backend container.
# DATABASE_URL=postgresql://app:app_password@postgres:5432/random_voice_social?schema=public
# REDIS_URL=redis://redis:6379

JWT_SECRET=replace_with_32_plus_random_bytes_for_production
JWT_EXPIRES_IN=30d
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://10.0.2.2:3000
MESSAGE_MAX_LENGTH=1000
REPORT_WINDOW_SECONDS=60
REPORT_MAX_PER_WINDOW=5
MESSAGE_WINDOW_SECONDS=10
MESSAGE_MAX_PER_WINDOW=8
QUEUE_WINDOW_SECONDS=10
QUEUE_MAX_PER_WINDOW=5
FRIEND_ADD_WINDOW_SECONDS=60
FRIEND_ADD_MAX_PER_WINDOW=10
BLOCK_WINDOW_SECONDS=60
BLOCK_MAX_PER_WINDOW=20
AUTH_WINDOW_SECONDS=60
AUTH_MAX_PER_WINDOW=30
TURN_REALM=random-voice.local
TURN_STATIC_URLS=stun:stun.l.google.com:19302,turn:localhost:3478?transport=udp
TURN_SHARED_SECRET=dev_turn_secret_replace
